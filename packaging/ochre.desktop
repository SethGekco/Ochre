[Desktop Entry]
Type=Application
Name=Ochre
GenericName=Image Editor
Comment=Layered image editor, with Command & Conquer sprite and terrain support
Exec=@ROOT@/run.sh %F
Path=@ROOT@
Icon=@ROOT@/assets/icon.png
Terminal=false
Categories=Graphics;2DGraphics;RasterGraphics;
Keywords=image;paint;draw;sprite;pixel;shp;tmp;
StartupNotify=true
MimeType=image/png;image/jpeg;image/bmp;image/gif;image/tiff;
